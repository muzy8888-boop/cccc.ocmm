
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Malware Analysis Lab</title>
<style>
:root {
  color-scheme: dark;
  --green: #00ff88;
  --dim: #168d60;
  --bg: #030806;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--green);
  font-family: Consolas, "Courier New", monospace;
}
header {
  padding: 22px 16px;
  border-bottom: 1px solid var(--dim);
  background: #06120c;
}
h1 { font-size: 22px; margin: 0 0 8px; }
.sub { color: #68bd93; font-size: 11px; }
main { padding: 16px; max-width: 900px; margin: auto; }
.grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 10px;
}
.panel {
  border: 1px solid #176c47;
  border-radius: 7px;
  padding: 14px;
  background: #06100b;
  min-width: 0;
}
.label { color: #71b995; font-size: 11px; }
.value { margin-top: 8px; font-size: 16px; }
.terminal {
  margin-top: 14px;
  border: 1px solid var(--dim);
  background: #010402;
  border-radius: 7px;
  overflow: hidden;
}
.termhead {
  padding: 12px;
  border-bottom: 1px solid #176c47;
  font-size: 12px;
}
#logs {
  height: 330px;
  overflow-y: auto;
  padding: 12px;
  font-size: 11px;
  line-height: 1.8;
  overflow-wrap: anywhere;
}
.log { margin-bottom: 5px; }
.time { color: #478c69; }
.tag { color: #00cfff; }
button {
  background: #062316;
  color: var(--green);
  border: 1px solid var(--green);
  border-radius: 5px;
  padding: 12px 16px;
  font-family: inherit;
  cursor: pointer;
}
button:active { background: #10492e; }
.actions { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; }
.progress {
  height: 5px;
  background: #163b29;
  margin-top: 12px;
}
#bar { height: 100%; width: 0%; background: var(--green); }
footer {
  text-align: center;
  color: #52866b;
  padding: 24px 8px;
  font-size: 10px;
}
@media(max-width:450px) {
  h1 { font-size: 18px; }
  #logs { height: 290px; }
}
</style>
</head>
<body>
<header>
  <h1>⬡ MALWARE ANALYSIS LAB</h1>
  <div class="sub">CYBERSECURITY RESEARCH // LAB-07</div>
  <div class="sub" style="margin-top:8px">
    LOCAL SIMULATION · NO SYSTEM ACCESS
  </div>
</header>

<main>
  <div class="grid">
    <div class="panel">
      <div class="label">LAB STATUS</div>
      <div class="value" id="status">● READY</div>
    </div>
    <div class="panel">
      <div class="label">THREAT EVENTS</div>
      <div class="value" id="count">0000</div>
    </div>
    <div class="panel">
      <div class="label">ANALYSIS ENGINE</div>
      <div class="value">SIMULATED</div>
    </div>
    <div class="panel">
      <div class="label">SANDBOX</div>
      <div class="value">ISOLATED</div>
    </div>
  </div>

  <div class="panel" style="margin-top:12px">
    <div class="label">ANALYSIS CYCLE</div>
    <div class="progress"><div id="bar"></div></div>
    <div class="sub" id="percent" style="margin-top:8px">0%</div>
  </div>

  <section class="terminal">
    <div class="termhead">
      <span>ROOT@MALWARE-LAB</span>
      <span style="float:right">LIVE EVENT LOG</span>
    </div>
    <div id="logs" aria-live="polite"></div>
  </section>

  <div class="actions">
    <button id="start">▶ START ANALYSIS</button>
    <button id="stop">■ STOP</button>
    <button id="clear">⌫ CLEAR LOG</button>
  </div>

  <footer>
    MALWARE ANALYSIS LAB · SIMULATION BUILD 1.0<br>
    All events are generated locally for demonstration.
  </footer>
</main>

<script>
const logs = document.getElementById("logs");
const statusEl = document.getElementById("status");
const countEl = document.getElementById("count");
const bar = document.getElementById("bar");
const percent = document.getElementById("percent");

const events = [
 ["SYSTEM","Initializing analysis environment"],
 ["ENGINE","Loading behavioral analysis module"],
 ["SANDBOX","Checking simulated isolation status"],
 ["SCAN","Inspecting mock application metadata"],
 ["PERMISSION","Reviewing sample permission manifest"],
 ["NETWORK","Simulating outbound connection event"],
 ["DNS","Generating simulated DNS telemetry"],
 ["FIREWALL","Evaluating mock firewall policy"],
 ["PROCESS","Analyzing virtual process events"],
 ["FILESYSTEM","Inspecting virtual test directory"],
 ["DETECTION","Running demonstration detection rules"],
 ["MONITOR","Recording behavioral telemetry"],
 ["SECURITY","Verifying simulation boundaries"],
 ["ANALYSIS","Comparing mock behavioral indicators"],
 ["REPORT","Updating local analysis timeline"],
 ["SYSTEM","No real system changes performed"],
 ["NETWORK","No real network traffic generated"],
 ["SANDBOX","Isolation simulation remains active"],
 ["DETECTION","Demo event classification completed"],
 ["REPORT","Analysis cycle completed"]
];

let running = false;
let timer = null;
let count = 0;
let cycle = 0;

function addLog(category, message) {
  const row = document.createElement("div");
  row.className = "log";

  const time = new Date().toLocaleTimeString("en-GB");
  const t = document.createElement("span");
  t.className = "time";
  t.textContent = "[" + time + "] ";

  const tag = document.createElement("span");
  tag.className = "tag";
  tag.textContent = "[" + category + "] ";

  const msg = document.createElement("span");
  msg.textContent = message;

  row.append(t, tag, msg);
  logs.appendChild(row);
  logs.scrollTop = logs.scrollHeight;

  count++;
  countEl.textContent = String(count).padStart(4,"0");
}

function tick() {
  if (!running) return;

  const event = events[cycle % events.length];
  addLog(event[0], event[1]);

  cycle++;
  const p = cycle % 101;
  bar.style.width = p + "%";
  percent.textContent = p + "% · SIMULATION PROGRESS";

  if (cycle % events.length === 0) {
    addLog("LAB", "Simulation cycle finished; restarting demo.");
  }
}

document.getElementById("start").onclick = () => {
  if (running) return;

  running = true;
  statusEl.textContent = "● RUNNING";
  addLog("SYSTEM", "Analysis session started.");
  timer = setInterval(tick, 700);
};

document.getElementById("stop").onclick = () => {
  running = false;
  clearInterval(timer);
  statusEl.textContent = "● PAUSED";
  addLog("SYSTEM", "Simulation paused by operator.");
};

document.getElementById("clear").onclick = () => {
  logs.replaceChildren();
  count = 0;
  countEl.textContent = "0000";
  addLog("SYSTEM", "Local demonstration log initialized.");
};

addLog("SYSTEM", "Malware Analysis Lab initialized.");
addLog("INFO", "Simulation mode enabled.");
addLog("SANDBOX", "No device or file access requested.");
</script>
</body>
</html>
